# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/borrowbox?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins (frontend URL(s))
CLIENT_ORIGIN=http://localhost:5173
